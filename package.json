{
  "name": "quick_typing_test",
  "version": "1.2.0",
  "description": "A typing test that runs in the browser popup.",
  "type": "module",
  "scripts": {
    "prebuild": "rimraf dist && node scripts/prebuild.js",
    "dev": "vite build --watch --mode development",
    "build": "tsc && vite build --mode production",
    "postbuild": "cd dist && zip -r dist.zip *",
    "lint": "eslint --config eslint.config.js ./src"
  },
  "author": "Utkarsh Bhatt",
  "dependencies": {
    "chart.js": "^4.4.4",
    "lucide-react": "^0.487.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/css": "^0.6.0",
    "@eslint/js": "^9.24.0",
    "@eslint/json": "^0.11.0",
    "@eslint/markdown": "^6.3.0",
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.24.0",
    "eslint-plugin-react": "^7.37.5",
    "glob": "^11.0.0",
    "globals": "^16.0.0",
    "postcss": "^8.4.47",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^10.0.3",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.11",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.29.1"
  }
}